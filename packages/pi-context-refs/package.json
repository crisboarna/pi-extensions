{
	"name": "@crisboarna/pi-context-refs",
	"version": "0.1.0",
	"description": "Save context refs and insert them from a picker as compact placeholders that expand to real content when the message is sent.",
	"type": "module",
	"license": "MIT",
	"author": "Cristian Boarna",
	"keywords": [
		"pi-package",
		"pi-extension",
		"context",
		"refs",
		"snippets",
		"placeholder",
		"picker",
		"prompt"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/crisboarna/pi-extensions.git",
		"directory": "packages/pi-context-refs"
	},
	"homepage": "https://github.com/crisboarna/pi-extensions/tree/main/packages/pi-context-refs#readme",
	"bugs": {
		"url": "https://github.com/crisboarna/pi-extensions/issues"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"pi": {
		"extensions": [
			"./src/index.ts"
		],
		"skills": [
			"./skills"
		],
		"image": "https://raw.githubusercontent.com/crisboarna/pi-extensions/main/packages/pi-context-refs/media/cover.png",
		"video": "https://raw.githubusercontent.com/crisboarna/pi-extensions/main/packages/pi-context-refs/media/hero.mp4"
	},
	"files": [
		"src",
		"skills",
		"schema",
		"examples",
		"README.md",
		"LICENSE"
	],
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=1.4.0 <2",
		"@earendil-works/pi-tui": ">=1.4.0 <2"
	},
	"scripts": {
		"test": "node --test --test-reporter=dot \"test/unit/**/*.test.ts\"",
		"test:integration": "node --test \"test/integration/**/*.test.ts\" \"test/tui/**/*.test.ts\"",
		"test:smoke": "node --test --test-concurrency=1 \"test/smoke/**/*.test.ts\"",
		"coverage": "mkdir -p coverage && CONTEXT_REFS_NATIVE_IMPORT=1 node --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info --test-coverage-include=\"src/**\" --test-coverage-lines=90 --test-coverage-branches=90 --test-coverage-functions=90 \"test/unit/**/*.test.ts\" \"test/integration/**/*.test.ts\" \"test/tui/**/*.test.ts\"",
		"media": "node media/data.ts && node ../../scripts/tools/media.ts packages/pi-context-refs/media"
	}
}
