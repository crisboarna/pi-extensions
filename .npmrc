# Supply-chain guards. scripts/checks/npm-policy.mjs fails if these drift.
# Dependencies may run install scripts only when allowed in package.json "allowScripts".
strict-allow-scripts=true
# Refuse versions published less than 3 days ago (most malicious releases are pulled within hours).
min-release-age=3
min-release-age-exclude[]=@crisboarna/*
save-exact=true
engine-strict=true
fund=false
