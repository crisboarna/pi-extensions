{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true
	},
	"include": [
		"packages/*/src",
		"packages/*/test",
		"packages/*/bin",
		"packages/*/scripts",
		"packages/*/media/*.ts",
		"packages/*/media/terminal",
		"tools/media/terminal-kit",
		"tools/site/*.ts",
