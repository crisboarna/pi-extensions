{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"rules": {
		"files": "error",
		"dependencies": "error",
		"devDependencies": "error",
		"optionalPeerDependencies": "error",
		"unlisted": "error",
		"binaries": "error",
		"unresolved": "error",
		"exports": "error",
		"nsExports": "error",
		"types": "error",
		"nsTypes": "error",
		"enumMembers": "error",
		"duplicates": "error"
	},
	"ignoreExportsUsedInFile": true,
	"workspaces": {
		".": {
			"entry": [
				"scripts/checks/*.ts",
				"scripts/hooks/*.ts",
				"scripts/tools/*.ts",
				"test/**/*.test.ts",
				"tools/site/build.ts",
				"tools/site/try/*.ts",
				"scripts/release/*.ts"
			],
			"project": ["scripts/**/*.ts", "test/**/*.ts", "tools/site/**/*.ts"]
		},
		"packages/*": {
			"entry": ["src/index.ts", "bin/*.mjs", "test/**/*.test.ts"],
			"project": ["src/**/*.ts", "bin/**/*.mjs", "test/**/*.ts"]
		}
	},
	"ignoreDependencies": [
		"@earendil-works/pi-agent-core",
		"@earendil-works/pi-ai",
		"@earendil-works/pi-coding-agent",
		"@earendil-works/pi-tui",
		"pi-subagents",
		"pi-powerline-footer",
		"@webcontainer/api",
		"@xterm/xterm",
		"@xterm/addon-fit",
		"coi-serviceworker"
	]
}
