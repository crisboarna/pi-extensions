{
	"name": "@crisboarna/pi-switchboard",
	"version": "0.1.0",
	"description": "Classifier-driven model tiers for pi: routes the main session and pi-subagents children by complexity, with several models per tier, health tracking and an audit trail.",
	"type": "module",
	"license": "MIT",
	"author": "Cristian Boarna",
	"keywords": [
		"pi-package",
		"pi-extension",
		"model-router",
		"model-routing",
		"classifier",
		"failover",
		"pi-subagents"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/crisboarna/pi-extensions.git",
		"directory": "packages/pi-switchboard"
	},
	"homepage": "https://github.com/crisboarna/pi-extensions/tree/main/packages/pi-switchboard#readme",
	"bugs": {
		"url": "https://github.com/crisboarna/pi-extensions/issues"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"bin": {
		"pi-switchboard": "./bin/pi-switchboard.mjs"
	},
	"pi": {
		"extensions": [
			"./src/index.ts"
		],
		"skills": [
			"./skills"
		],
		"image": "https://raw.githubusercontent.com/crisboarna/pi-extensions/main/packages/pi-switchboard/media/cover.png",
		"video": "https://raw.githubusercontent.com/crisboarna/pi-extensions/main/packages/pi-switchboard/media/hero.mp4"
	},
	"files": [
		"src",
		"bin",
		"schema",
		"data",
		"examples",
		"skills",
		"README.md",
		"LICENSE"
	],
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"dependencies": {
		"jiti": "2.7.0"
	},
	"scripts": {
		"test": "node --test --test-reporter=dot \"test/unit/**/*.test.ts\"",
		"test:integration": "node --test \"test/integration/**/*.test.ts\"",
		"test:e2e": "node --test --test-concurrency=1 \"test/e2e/*.test.ts\"",
		"coverage": "SWITCHBOARD_NATIVE_IMPORT=1 node --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-lines=90 --test-coverage-branches=90 --test-coverage-functions=90 \"test/unit/**/*.test.ts\" \"test/integration/**/*.test.ts\"",
		"media": "node media/data.ts && node ../../scripts/tools/media.ts packages/pi-switchboard/media"
	}
}
